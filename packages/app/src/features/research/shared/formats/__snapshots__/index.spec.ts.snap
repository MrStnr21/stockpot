{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "aliases": {
      "description": "Other names, spellings and abbreviations of the term in this meaning.",
      "items": {
        "description": "Another name or spelling. At most 80 characters.",
        "maxLength": 80,
        "minLength": 1,
        "type": "string",
      },
      "maxItems": 5,
      "minItems": 0,
      "type": "array",
    },
    "difficulty": {
      "description": "How hard the word is for an upper-intermediate learner to use correctly.",
      "enum": [
        "easy",
        "medium",
        "hard",
      ],
      "type": "string",
    },
    "examples": {
      "description": "Two usage examples, each with its translation.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "description": "A short sentence that uses the word the way people really do. At most 300 characters.",
            "maxLength": 300,
            "minLength": 1,
            "type": "string",
          },
          "translation": {
            "description": "The sentence in the card language. At most 300 characters.",
            "maxLength": 300,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "text",
          "translation",
        ],
        "type": "object",
      },
      "maxItems": 3,
      "minItems": 2,
      "type": "array",
    },
    "mistake": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
      "description": "The mistake learners typically make with it (articles, calques from their own language, false friends), or null when there is none worth noting. At most 300 characters.",
    },
    "modelSentences": {
      "description": "Two sentences the reader can reuse as templates, with the word in a common construction.",
      "items": {
        "description": "One sentence. At most 300 characters.",
        "maxLength": 300,
        "minLength": 1,
        "type": "string",
      },
      "maxItems": 3,
      "minItems": 2,
      "type": "array",
    },
    "partOfSpeech": {
      "description": "The part of speech.",
      "enum": [
        "noun",
        "verb",
        "adjective",
        "adverb",
        "phrasal verb",
        "idiom",
        "phrase",
        "other",
      ],
      "type": "string",
    },
    "sense": {
      "description": "The meaning of the term this card explains, in a few words, such as "YouTube streaming protocol". Name it even when the term has only one meaning. At most 120 characters.",
      "maxLength": 120,
      "minLength": 1,
      "type": "string",
    },
    "sources": {
      "description": "Dictionary or usage pages, only for slang and new expressions; usually empty.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "title": {
            "description": "The title of the page, as the page itself shows it. At most 200 characters.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "url": {
            "description": "The address of a page you opened or saw in search results while writing this card. Never an address from memory or one you built yourself.",
            "format": "uri",
            "maxLength": 2000,
            "pattern": "^https?:\\/\\/",
            "type": "string",
          },
        },
        "required": [
          "title",
          "url",
        ],
        "type": "object",
      },
      "maxItems": 3,
      "minItems": 0,
      "type": "array",
    },
    "translation": {
      "description": "The translation into the card language: one word, or a few when one is not enough. At most 160 characters.",
      "maxLength": 160,
      "minLength": 1,
      "type": "string",
    },
    "uncertain": {
      "description": "True when you could not confirm the main facts: the term is too new, too narrow or ambiguous, or the sources disagree.",
      "type": "boolean",
    },
  },
  "required": [
    "sense",
    "aliases",
    "translation",
    "partOfSpeech",
    "difficulty",
    "examples",
