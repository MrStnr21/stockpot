// SPDX-FileCopyrightText: 2026 The stockpot authors

import { Icon } from '@stockpot/ui/icon'
import { Tab, TabBar } from '@stockpot/ui/tab-bar'

import SideRail from '#/components/side-rail.astro'
import Sidebar from '#/components/sidebar.astro'
import Layout from '#/layouts/layout.astro'
import { t, type Locale } from '#/lib/i18n'
import { navItems, type NavCounts, type NavKey } from '#/lib/nav'
import { config } from '#/server/config'

interface Props {
	/** The page's name, ahead of "stockpot" in the document title. */
	title: string
	locale: Locale
	/** The tab to mark as the current page; `null` on a page that is none of them. */
	current: NavKey | null
	/** The visible page heading; leave it out when the page draws its own. */
	heading?: string
	counts?: NavCounts
}

const {
	title,
	locale,
	current,
	heading,
	counts = { today: null, notes: null, base: null },
} = Astro.props

const strings = t(locale)

// The strings depend on the request's Accept-Language, so a shared cache must keep one copy per value.
Astro.response.headers.append('Vary', 'Accept-Language')
---

<Layout title={`${title} · stockpot`} lang={locale}>
	<div class="min-h-dvh md:pl-rail xl:pl-sidebar">
		<SideRail label={strings.nav.label} {current} {counts} strings={strings.nav} />
		<Sidebar {current} {counts} {strings} sourceUrl={config.sourceUrl} />
		<div class="fixed inset-x-0 bottom-0 z-5 md:hidden">
			<TabBar label={strings.nav.label}>
				{navItems.map((item) => (
					<Tab
						href={item.href}
						icon={item.icon}
						current={item.key === current}
						add={item.key === 'add'}
						badge={item.key === 'today' ? counts.today : null}
					>
						{strings.nav[item.key]}
					</Tab>
				))}
			</TabBar>
		</div>
		<main class="mx-auto flex w-full flex-col px-4 pt-[max(calc(env(safe-area-inset-top)+--spacing(3)),--spacing(6))] pb-[calc(--spacing(16)+env(safe-area-inset-bottom)+--spacing(6))] md:px-10 md:pt-14 md:pb-10 xl:px-8">
			<div class="mx-auto flex w-full max-w-column flex-col gap-4 md:gap-5">
				<div
					role="status"
					class="hidden items-start gap-2.5 rounded-md bg-fill px-3.5 py-3 font-ui text-body-s text-ink-2 in-data-[connection=offline]:flex"
				>
					<Icon name="alert" class="size-5" />
					<span>
						<b class="font-semibold text-ink">{strings.offline.title}</b> {strings.offline.body}
					</span>
				</div>
				{heading !== undefined && <h1 class="pt-2 text-title-l">{heading}</h1>}
				<slot />
			</div>
		</main>
	</div>
</Layout>
