import { Icon } from '@stockpot/ui/icon'
import { Tab, TabBar } from '@stockpot/ui/tab-bar'

import SideRail from '#/components/side-rail.astro'
import Sidebar from '#/components/sidebar.astro'
import CaptureSheet from '#/features/capture/client/capture-sheet.svelte'
import { listCategories } from '#/features/categories/server'
import Layout from '#/layouts/layout.astro'
import { categoryLook } from '#/lib/category-look'
import { t, type Locale } from '#/lib/i18n'
import { navItems, type NavCounts, type NavKey } from '#/lib/nav'
import { config } from '#/server/config'
import { instanceDb } from '#/server/db/instance'

interface Props {
	/** The page's name, ahead of "stockpot" in the document title. */
	title: string
	locale: Locale
	/** The tab to mark as the current page; `null` on a page that is none of them. */
	current: NavKey | null
	/** The visible page heading; leave it out when the page draws its own. */
	heading?: string
	counts?: NavCounts
	/** Opens the capture sheet once the page runs, as on `/add`. */
	initiallyOpen?: boolean
	/** The public offline page leaves the sheet out: it would carry the owner's categories. */
	capture?: boolean
	/**
	 * `column`: one reading column. `split`: from `md`, the page fills the screen beside the rail and
	 * draws its own columns, each scrolling on its own; phones keep the column paddings.
	 */
	layout?: 'column' | 'split'
}

const {
	title,
	locale,
	current,
	heading,
	counts = { today: null, notes: null, base: null },
	initiallyOpen = false,
	capture = true,
	layout = 'column',
} = Astro.props

const strings = t(locale)

// The strings depend on the request's Accept-Language, so a shared cache must keep one copy per value.
Astro.response.headers.append('Vary', 'Accept-Language')

function captureCategory({
	id,
	name,
	color,
	icon,
}: {
	id: number
	name: string
	color: string
	icon: string
}) {
	const look = categoryLook(color, icon)

	return { id, name, color: look.color, icon: look.icon }
}

const captureCategories =
	capture && Astro.locals.owner !== null
		? listCategories(await instanceDb()).map((category) => captureCategory(category))
		: null
---

<Layout title={`${title} · stockpot`} lang={locale}>
	<div class="min-h-dvh md:pl-rail xl:pl-sidebar">
		<SideRail label={strings.nav.label} {current} {counts} strings={strings.nav} />
		<Sidebar {current} {counts} {strings} sourceUrl={config.sourceUrl} />
		<div class="fixed inset-x-0 bottom-0 z-5 md:hidden">
			<TabBar label={strings.nav.label}>
				{navItems.map((item) => (
					<Tab
						href={item.href}
						icon={item.icon}
						current={item.key === current}
						add={item.key === 'add'}
						badge={item.key === 'today' ? counts.today : null}
					>
						{strings.nav[item.key]}
					</Tab>
				))}
			</TabBar>
		</div>
		<main
			data-layout={layout}
			class="group/main mx-auto flex w-full flex-col px-4 pt-[max(calc(env(safe-area-inset-top)+--spacing(3)),--spacing(6))] pb-[calc(--spacing(16)+env(safe-area-inset-bottom)+--spacing(6))] md:px-10 md:pt-14 md:pb-10 xl:px-8 md:data-[layout=split]:h-dvh md:data-[layout=split]:p-0"
		>
			<div class="mx-auto flex w-full max-w-column flex-col gap-4 md:gap-5 md:group-data-[layout=split]/main:min-h-0 md:group-data-[layout=split]/main:max-w-none md:group-data-[layout=split]/main:flex-1 md:group-data-[layout=split]/main:gap-0">
				<div
					role="status"
					class="hidden items-start gap-2.5 rounded-md bg-fill px-3.5 py-3 font-ui text-body-s text-ink-2 in-data-[connection=offline]:flex md:group-data-[layout=split]/main:m-4"
				>
					<Icon name="alert" class="size-5" />
					<span>
						<b class="font-semibold text-ink">{strings.offline.title}</b> {strings.offline.body}
					</span>
				</div>
				{heading !== undefined && <h1 class="pt-2 text-title-l">{heading}</h1>}
				<slot />
			</div>
		</main>
		{captureCategories !== null && (
			<CaptureSheet
				client:idle
				categories={captureCategories}
				strings={strings.capture}
				{initiallyOpen}
			/>
		)}
	</div>
</Layout>
