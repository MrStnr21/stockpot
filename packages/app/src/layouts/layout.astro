import '#/main.css'

import interFont from '@stockpot/ui/fonts/inter/InterVariable.woff2?url'
import literataFont from '@stockpot/ui/fonts/literata/LiterataVariable.woff2?url'

import type { Locale } from '#/lib/i18n'

interface Props {
	title: string
	lang?: Locale
}

const { title, lang = 'en' } = Astro.props
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#fffeff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#1d1418" media="(prefers-color-scheme: dark)" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="stockpot" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<!-- The two faces every page draws; the URLs are the fingerprinted files the CSS refers to. -->
		<link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={literataFont} as="font" type="font/woff2" crossorigin />
		<title>{title}</title>
		<script is:inline>
			/* The shell's offline banner shows while this attribute is set; the worker sets it on a stored page. */
			if (!navigator.onLine) {
				document.documentElement.dataset.connection = 'offline'
			}

			for (const state of ['online', 'offline']) {
				addEventListener(state, () => {
					if (state === 'offline') {
						document.documentElement.dataset.connection = 'offline'
					} else {
						delete document.documentElement.dataset.connection
					}
				})
			}
		</script>
		{import.meta.env.PROD && <script is:inline>
			/* After load, so the worker's first download does not compete with the page. */
			if ('serviceWorker' in navigator) {
				addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js', { scope: '/' })
				})
			}
		</script>}
	</head>
	<body class="bg-canvas font-sans text-ink antialiased">
		<slot />
	</body>
</html>
