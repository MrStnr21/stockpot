import { Wordmark } from '@stockpot/ui/wordmark'

import Layout from '#/layouts/layout.astro'
import { instanceAuth, setupFormSchema } from '#/server/auth'
import { readForm } from '#/server/http'

// A placeholder form: the first-run screens are styled in a WEB story.

/** A redirect, or the error to show with the form (none on a first visit). */
async function handle(): Promise<Response | string | undefined> {
	const auth = await instanceAuth()

	if (Astro.locals.owner !== null) {
		return Astro.redirect('/', 303)
	}

	if (!auth.needsSetup()) {
		return Astro.redirect('/signin', 303)
	}

	if (Astro.request.method !== 'POST') {
		return undefined
	}

	const form = await readForm(Astro.request, setupFormSchema)

	if (!form.success) {
		Astro.response.status = 400

		return form.issues[0].message
	}

	const result = await auth.setUp(Astro.cookies, form.output)

	if (result !== 'wrong_code') {
		return Astro.redirect(result === 'created' ? '/' : '/signin', 303)
	}

	Astro.response.status = 403

	return 'That is not the setup code in the server log.'
}

const outcome = await handle()

if (outcome instanceof Response) {
	// oxlint-disable-next-line unicorn/prefer-module -- Astro runs the frontmatter as a function, and a page redirects by returning the response.
	return outcome
}

const error = outcome
---

<Layout title="Set up stockpot">
	<main class="mx-auto flex min-h-dvh max-w-xl flex-col justify-center gap-8 px-6">
		<Wordmark />
		<form method="post" class="flex flex-col gap-4">
			<h1 class="text-xl font-semibold">Set up your instance</h1>
			<p>
				The server printed a setup code to its log when it started. Enter it with the password you
				will sign in with.
			</p>
			{error && <p role="alert">{error}</p>}
			<label class="flex flex-col gap-1">
				Setup code
				<input name="code" required autocomplete="one-time-code" class="rounded border px-3 py-2" />
			</label>
			<label class="flex flex-col gap-1">
				Password, at least 12 characters
				<input
					name="password"
					type="password"
					required
					minlength="12"
					autocomplete="new-password"
					class="rounded border px-3 py-2"
				/>
			</label>
			<label class="flex flex-col gap-1">
				The password again
				<input
					name="confirmation"
					type="password"
					required
					minlength="12"
					autocomplete="new-password"
					class="rounded border px-3 py-2"
				/>
			</label>
			<button type="submit" class="rounded border px-3 py-2">
				Create the owner
			</button>
		</form>
	</main>
</Layout>
