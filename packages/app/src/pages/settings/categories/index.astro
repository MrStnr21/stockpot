---
// SPDX-License-Identifier: AGPL-3.0-or-later
// SPDX-FileCopyrightText: 2026 The stockpot authors

import { Button } from '@stockpot/ui/button'

import { listCategories } from '#/features/categories/server'
import CategoryList from '#/features/settings/client/category-list.svelte'
import SettingsFrame from '#/features/settings/client/settings-frame.astro'
import { readSettingsOverview } from '#/features/settings/server/overview'
import type { CategoryRow } from '#/features/settings/shared/types'
import Shell from '#/layouts/shell.astro'
import { pickLocale, t } from '#/lib/i18n'
import { instanceDb } from '#/server/db/instance'

// Sign-in sends a visitor on to setup while the instance has no owner.
if (Astro.locals.owner === null) {
	// oxlint-disable-next-line unicorn/prefer-module -- Astro runs the frontmatter as a function, and a page redirects by returning the response.
	return Astro.redirect('/signin')
}

const locale = pickLocale(Astro.request.headers.get('accept-language'))

const strings = t(locale)

const s = strings.settings

const db = await instanceDb()

const { attention } = readSettingsOverview(db, new Date())

// The rows as `GET /api/categories` lists them, without the timestamps.
const categories: CategoryRow[] = listCategories(db).map(
	({ id, name, icon, color, format, instructions, position, noteCount }) => ({
		id,
		name,
		icon,
		color,
		format,
		instructions,
		position,
		noteCount,
	}),
)
---

<!-- DES-5 390-02 and 768/1440: the list in the board's order, dragged or moved with keys. -->
<Shell title={s.categories.title} {locale} current="settings" layout="split">
	<SettingsFrame
		section="categories"
		{strings}
		{attention}
		back={{ href: '/settings', label: strings.nav.settings }}
	>
		<a
			slot="action"
			href="/settings/categories/new"
			class="inline-flex min-h-11 items-center rounded-sm px-1 font-ui text-label font-medium text-accent-ink outline-focus focus-visible:outline-2 focus-visible:outline-offset-2"
		>
			{s.categories.new}
		</a>
		<h1 class="font-ui text-title-l md:pt-2">{s.categories.title}</h1>
		<p class="-mt-2 font-ui text-body-compact text-ink-2">{s.categories.intro}</p>
		<CategoryList
			client:load
			{categories}
			strings={{ categories: s.categories, formats: s.formats, errors: s.errors }}
		/>
		<Button href="/settings/categories/new" variant="tonal" icon="plus" block>
			{s.categories.newCategory}
		</Button>
	</SettingsFrame>
</Shell>
