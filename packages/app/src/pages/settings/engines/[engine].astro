// SPDX-FileCopyrightText: 2026 The stockpot authors

import { Button } from '@stockpot/ui/button'
import { EmptyState } from '@stockpot/ui/empty-state'

import EngineDetails from '#/features/settings/client/engine-details.svelte'
import type { KeyEngine } from '#/features/settings/client/engine-key.svelte'
import { engineName } from '#/features/settings/client/engine-view'
import SettingsFrame from '#/features/settings/client/settings-frame.astro'
import { readSettingsOverview } from '#/features/settings/server/overview'
import Shell from '#/layouts/shell.astro'
import { pickLocale, t } from '#/lib/i18n'
import { instanceDb } from '#/server/db/instance'

// Sign-in sends a visitor on to setup while the instance has no owner.
if (Astro.locals.owner === null) {
	// oxlint-disable-next-line unicorn/prefer-module -- Astro runs the frontmatter as a function, and a page redirects by returning the response.
	return Astro.redirect('/signin')
}

const locale = pickLocale(Astro.request.headers.get('accept-language'))

const strings = t(locale)

const s = strings.settings

const keyEngines = ['gemini', 'openai-compatible'] as const satisfies readonly KeyEngine[]

// The agent command has no details: it is set up in the server's environment.
const engine = keyEngines.find((id) => id === Astro.params.engine) ?? null

const db = await instanceDb()

const now = new Date()

// Only the public settings leave the server: the keys stay inside readSettingsOverview.
const { settings, engines, attention } = readSettingsOverview(db, now)

const overview = engines.find(({ id }) => id === engine) ?? null

// The status is set here: a component renders after the page has started its answer.
if (overview === null) {
	Astro.response.status = 404
}

const title = engine === null ? s.engines.missingTitle : engineName(engine, s.engines)
---

<!-- DES-5 390-07: one engine's last call, key, models and today's calls. -->
<Shell {title} {locale} current="settings" layout="split">
	<SettingsFrame
		section="engines"
		{strings}
		{attention}
		back={{ href: '/settings/engines', label: s.engines.title }}
	>
		{engine === null || overview === null ? (
			<>
				<Button variant="ghost" size="sm" href="/settings/engines" class="-ms-2.5 self-start">
					{s.engines.title}
				</Button>
				<h1 class="sr-only">{title}</h1>
				<EmptyState icon="bolt" title={title}>
					{s.engines.missing}
				</EmptyState>
			</>
		) : (
			<>
				<h1 class="font-ui text-title-l md:pt-2">{title}</h1>
				<EngineDetails
					client:load
					{engine}
					engines={settings.engines}
					{overview}
					now={now.toISOString()}
					{locale}
					timeZone={settings.digest.timeZone}
					strings={{
						engines: s.engines,
						engineState: s.engineState,
						testOutcome: s.testOutcome,
						when: s.when,
						keys: s.keys,
						models: s.models,
						errors: s.errors,
					}}
				/>
			</>
		)}
	</SettingsFrame>
</Shell>
