/*
 * A note's opened card on its own page: on a phone with the actions pinned where the tab bar was,
 * from 768 in the reading column. A missing or deleted note answers 404.
 */
import { Button } from '@stockpot/ui/button'
import { EmptyState } from '@stockpot/ui/empty-state'

import { listCategories } from '#/features/categories/server'
import { statusLabels } from '#/features/notes/client/row-view'
import CardPage from '#/features/research/client/card-page.svelte'
import { readCardView } from '#/features/research/server/card-view'
import { readBatchTime, readTimeZone } from '#/features/settings/server'
import { instanceProgressBoard } from '#/instance'
import Shell from '#/layouts/shell.astro'
import { categoryLook } from '#/lib/category-look'
import { pickLocale, t } from '#/lib/i18n'
import { instanceDb } from '#/server/db/instance'

// Sign-in sends a visitor on to setup while the instance has no owner.
if (Astro.locals.owner === null) {
	// oxlint-disable-next-line unicorn/prefer-module -- Astro runs the frontmatter as a function, and a page redirects by returning the response.
	return Astro.redirect('/signin')
}

const locale = pickLocale(Astro.request.headers.get('accept-language'))

const strings = t(locale)

const db = await instanceDb()

const rawId = Astro.params.id ?? ''

const view = /^[1-9]\d{0,14}$/u.test(rawId)
	? readCardView(db, instanceProgressBoard, { noteId: Number(rawId), now: new Date() })
	: null

const categories = listCategories(db).map(({ id, name, color, icon }) => {
	const look = categoryLook(color, icon)

	return { id, name, color: look.color, icon: look.icon }
})

if (view === null) {
	Astro.response.status = 404
}
---

<Shell
	title={view?.note.text ?? strings.card.missingTitle}
	{locale}
	current="notes"
	tabBar={view === null}
>
	{view === null ? (
		<>
			<Button variant="ghost" size="sm" href="/notes" class="-ms-2.5 self-start">
				{strings.notes.heading}
			</Button>
			<h1 class="sr-only">{strings.card.missingTitle}</h1>
			<EmptyState icon="search" title={strings.card.missingTitle}>
				{strings.card.missing}
			</EmptyState>
		</>
	) : (
		<CardPage
			client:load
			initial={view}
			{categories}
			timeZone={readTimeZone(db)}
			batchTime={readBatchTime(db)}
			{locale}
			strings={strings.card}
			statuses={statusLabels(strings.notes)}
		/>
	)}
</Shell>
