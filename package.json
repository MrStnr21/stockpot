{
	"name": "stockpot",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"packageManager": "bun@1.4.3",
	"workspaces": [
		"packages/*",
		"tools"
	],
	"scripts": {
		"dev": "bun run -F @stockpot/app dev",
		"build": "bun run -F @stockpot/app build",
		"start": "bun run -F @stockpot/app start",
		"check": "bun run --filter '@stockpot/*' check",
		"test": "bun run --filter '@stockpot/*' test",
		"e2e": "bun run -F @stockpot/app e2e",
		"fmt": "bun run --filter '@stockpot/*' fmt && bunx --bun prettier --cache --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude --write .",
		"fmt:check": "bun run --filter '@stockpot/*' fmt:check && bunx --bun prettier --cache --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude --check .",
		"lint": "bun run --filter '@stockpot/*' lint",
		"lint:fix": "bun run --filter '@stockpot/*' lint:fix",
		"check:license": "bun tools/license/check-license.ts",
		"notices": "bun tools/notices/generate-notices.ts",
		"postinstall": "lefthook install"
	},
	"devDependencies": {
		"@configg/bases": "^0.1.11",
		"@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
		"lefthook": "^2.2.2",
		"prettier": "^3.10.1",
		"secretlint": "^14.0.1"
	}
}
